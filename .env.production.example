# Copiar a .env.production en el servidor. Nunca subirlo al repositorio.
# Las variables vacías se dejan comentadas: una variable definida pero vacía se rechaza al arrancar.

# Dominio (registro A/AAAA apuntando a este servidor) y URL pública de la tienda
DOMAIN=tu-dominio.cl
APP_URL=https://tu-dominio.cl
APP_ENV=production

# Base de datos (contraseña larga y propia: openssl rand -hex 24)
POSTGRES_USER=tienda
POSTGRES_PASSWORD=cambia-esta-clave-por-una-larga
POSTGRES_DB=tienda

# Caddy delante de la app
TRUSTED_PROXY_HOPS=1

# Pedidos: minutos que se reserva el stock esperando el pago
RESERVATION_TTL_MINUTES=30
# TRANSFER_RESERVATION_MINUTES=1440

# Correos al cliente (remitente verificado en Resend)
MAIL_FROM=Tienda <pedidos@tu-dominio.cl>
# RESEND_API_KEY=re_...
