# Copiar a .env y completar. Nunca subir .env al repositorio.
DATABASE_URL=postgres://tienda:tienda@localhost:5432/tienda
# Base separada para tests (se recrea en cada corrida de `npm test`)
DATABASE_URL_TEST=postgres://tienda:tienda@localhost:5432/tienda_test
APP_URL=http://localhost:3000
SESSION_TTL_DAYS=30
RESERVATION_TTL_MINUTES=30
# Imágenes subidas desde el panel (disco local; en producción, un volumen persistente)
UPLOAD_DIR=./uploads

# Solo para `npm run db:seed` en desarrollo
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=cambiar-esta-clave-demo

# ── Pendiente (FASE 7): se agregan cuando existan credenciales reales ──
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# WEBPAY_ENVIRONMENT=integration|production
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
